# Wird von lib/api.mjs gelesen. Werte nie in den Chat kopieren, nur hier eintragen.

# ElevenLabs, EU-Residency-Konto (Schlüssel endet auf _residency_eu oder gehört zum EU-Stack).
# Rechte: ElevenLabs Agents (lesen + schreiben), Speech to Text.
ELEVENLABS_API_KEY=

# Twilio: Konto-SID (beginnt mit AC) und ein API-Schlüssel, der in der Region IE1 (Irland) erstellt wurde.
TWILIO_ACCOUNT_SID=
TWILIO_KEY_SID=
TWILIO_KEY_SECRET=

# Nur nötig, wenn die Nummer neu in ElevenLabs importiert werden muss (skripte/nummer.mjs importieren).
TWILIO_AUTH_TOKEN_IE1=
