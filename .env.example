# Wird von lib/api.mjs gelesen. Werte nie in den Chat kopieren, nur hier eintragen.

# ElevenLabs. Mindestrechte: ElevenLabs Agents (lesen + schreiben). Optional: Voices (lesen) für die
# Stimmenliste, Speech to Text für Mitschnitt-Transkripte. Tabelle in INSTALL.md, Schritt 3.
ELEVENLABS_API_KEY=
# Nur bei Data-Residency-Konten setzen, z. B. EU: https://api.eu.residency.elevenlabs.io
ELEVENLABS_API_BASE=

# Twilio: Konto-SID (beginnt mit AC) und ein API-Schlüssel (SID beginnt mit SK) aus derselben Region wie die Nummer.
TWILIO_ACCOUNT_SID=
TWILIO_KEY_SID=
TWILIO_KEY_SECRET=
# Nur wenn das Konto/die Nummer nicht in der Standardregion US1 liegt, z. B. Irland: https://api.dublin.ie1.twilio.com
TWILIO_API_BASE=

# Optional, nur für den Mitschneider (skripte/make.mjs). Immer der eigene Make-Zugang.
# Token-Rechte: scenarios:read, scenarios:write, hooks:read, hooks:write, keys:write
MAKE_API_TOKEN=
# Zone des eigenen Make-Kontos, z. B. https://eu2.make.com/api/v2
MAKE_API_BASE=
# Team-ID aus Make (steht in der Adresse, wenn man in Make das Team öffnet)
MAKE_TEAM_ID=
