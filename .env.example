# Wird von lib/api.mjs gelesen. Werte nie in den Chat kopieren, nur hier eintragen.

# ElevenLabs. Rechte des Schlüssels: ElevenLabs Agents (lesen + schreiben), Voices (lesen), Speech to Text.
ELEVENLABS_API_KEY=
# Nur bei Data-Residency-Konten setzen, z. B. EU: https://api.eu.residency.elevenlabs.io
ELEVENLABS_API_BASE=

# Twilio: Konto-SID (beginnt mit AC) und ein API-Schlüssel (SID beginnt mit SK) aus derselben Region wie die Nummer.
TWILIO_ACCOUNT_SID=
TWILIO_KEY_SID=
TWILIO_KEY_SECRET=
# Nur wenn das Konto/die Nummer nicht in der Standardregion US1 liegt, z. B. Irland: https://api.dublin.ie1.twilio.com
TWILIO_API_BASE=
